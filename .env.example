# Work-by-Request-Type — local configuration (copy to .env and fill in).
# .env is gitignored; nothing here is committed. The Forge CLI does NOT auto-load
# this file — `scripts/forge-env.sh` reads it to export APP_ID and push the
# runtime variables to Forge (`forge variables set`).

# --- Forge app identity -----------------------------------------------------
# Your registered Forge app id. Generate one with `forge register` (writes it
# to the app / your .env), or paste an existing app's id. Injected into
# manifest.yml as ${APP_ID} at deploy time so no id is hardcoded in the repo.
APP_ID=ari:cloud:ecosystem::app/00000000-0000-0000-0000-000000000000

# --- Runtime variables (pushed to Forge via scripts/forge-env.sh) -----------
# Default Jira filter the gadget reads. Also overridable per-gadget in the
# config UI; this is the fallback when an instance hasn't set one.
SOURCE_FILTER_ID=

# Custom field id holding the JSM "Request Type" on your site (varies per site;
# customfield_10010 is a common default). Grouping is dynamic from this field's
# value — the request-type name is embedded in it.
REQUEST_TYPE_FIELD=customfield_10010

# Optional fallback JQL used only if the filter above can't be read. Leave blank
# to error out instead of guessing a query.
SOURCE_FALLBACK_JQL=

# --- Install targets (used by forge install commands; not read by the app) --
JIRA_SITE=your-site.atlassian.net
JIRA_CLOUD_ID=
